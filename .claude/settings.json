{
  "env": {
    "IMPECCABLE_CONTEXT_DIR": "docs"
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env*.local)",
      "Read(./.env.production)",
      "Edit(./.env)",
      "Edit(./.env*.local)",
      "Edit(./.env.production)",
      "Bash(npx supabase db reset *)",
      "Bash(supabase db reset *)"
    ],
    "ask": [
      "Bash(npm run db:push)",
      "Bash(npm run db:push *)",
      "Bash(npx supabase db push)",
      "Bash(npx supabase db push *)",
      "Bash(supabase db push)",
      "Bash(supabase db push *)",
      "Bash(npx supabase functions deploy *)",
      "Bash(supabase functions deploy *)"
    ],
    "allow": [
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run test:*)",
      "Bash(npm run format:check:*)",
      "Bash(npm run build:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx impeccable detect:*)",
      "Bash(npx supabase migration list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-applied-migration.mjs",
            "timeout": 10,
            "statusMessage": "Checking migration immutability"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-remote-writes.mjs",
            "timeout": 10,
            "statusMessage": "Checking push target and PR action"
          }
        ]
      }
    ]
  }
}
